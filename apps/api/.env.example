# Copy to app/.env and fill in real values. NEVER commit app/.env.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/kabarbers
JWT_SECRET=change-me-to-a-long-random-secret

# Seeded owner (created/kept in sync on server start)
OWNER_EMAIL=owner@kabarbers.local
OWNER_PASSWORD=owner123
OWNER_NAME=Kabarbers Owner

# Login with Facebook (OAuth2 Authorization Code)
FACEBOOK_APP_ID=2072154290149240
FACEBOOK_APP_SECRET=
# Optional: override the Meta Graph API version (default v25.0).
# FACEBOOK_GRAPH_VERSION=v25.0
FRONTEND_URL=http://localhost:5173
