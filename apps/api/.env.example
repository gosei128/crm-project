# Copy to app/.env and fill in real values. NEVER commit app/.env.
# Production needs its own database + secrets — never reuse dev values.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/kabarbers
JWT_SECRET=change-me-to-a-long-random-secret
# Token lifetime in minutes (default 30).
JWT_EXPIRE_MINUTES=30
# Set APP_ENV=production in prod (disables SQL echo).
APP_ENV=dev

# Seeded owner (created/kept in sync on server start).
# PRODUCTION: override OWNER_PASSWORD with a strong secret before first boot.
OWNER_EMAIL=owner@kabarbers.local
OWNER_PASSWORD=owner123
OWNER_NAME=Kabarbers Owner

# CORS: comma-separated list of allowed frontend origins.
# PRODUCTION: set to your real domain, e.g. https://kabarbers.example.com
# FRONTEND_URL is auto-included, but set both explicitly to be safe.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Rate limiting (slowapi, per-IP). Tighten in production if abused.
# RATE_LIMIT_ENABLED=true
# LOGIN_RATE_LIMIT=60/minute
# BOOKING_RATE_LIMIT=120/minute
# UPLOAD_RATE_LIMIT=60/minute
# LOOKUP_RATE_LIMIT=30/minute
# Guest tickets stop resolving this many days after Haircut Done.
# COMPLETED_LOOKUP_DAYS=7

# Login with Facebook (OAuth2 Authorization Code)
FACEBOOK_APP_ID=2072154290149240
FACEBOOK_APP_SECRET=
# Optional: override the Meta Graph API version (default v25.0).
# FACEBOOK_GRAPH_VERSION=v25.0
FRONTEND_URL=http://localhost:5173
